# ==============================================================================
# Normaliza finales de línea a LF para todo el código/texto del repo.
#
# Sin esto, en máquinas Windows con `core.autocrlf=true` un simple checkout +
# commit puede reescribir un archivo entero con CRLF -confirmado en la rama
# feature/azure: docker_images/gateway/docker-compose.yml traía 624 líneas
# "cambiadas" que eran, en realidad, 312 líneas re-escritas con \r\n sin
# ningún cambio de contenido real (ver el commit de merge que descartó ese
# ruido). `text=auto` normaliza a LF en el objeto de Git para archivos de
# texto detectados automáticamente; el checkout local sigue respetando
# core.autocrlf para el editor, pero el blob almacenado siempre es LF.
# ==============================================================================
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.js    text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.j2    text eol=lf
Dockerfile text eol=lf

# Binarios: nunca tocar finales de línea.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
