# ==============================================================================
# Sooniverse Demo - Variables del Gateway contra proveedor externo
# ==============================================================================
# Copia a demo/.env.demo y rellena:   cp demo/.env.demo.example demo/.env.demo
#
# Reglas:
#   - SIN comillas en los valores (docker compose y scripts/db_setup.py las leen
#     distinto).
#   - Genera cada secreto con:   openssl rand -hex 32
#   - demo/.env.demo está en demo/.gitignore: NUNCA lo subas al repo.
#   - deploy_demo.sh añade aquí OPENWEBUI_LITELLM_API_KEY la primera vez (key
#     virtual de la interfaz de chat; el panel la muestra como "Interfaz Web").
# ==============================================================================

# --- Dominio y exposición -----------------------------------------------------
# Subdominio dedicado con registro A -> IP del VPS.
DEMO_DOMAIN=demo.tudominio.com
# Puerto LOCAL (solo 127.0.0.1) donde escucha el nginx del stack. El Nginx del
# host hace proxy aquí. Elige uno libre (ss -ltn); nunca 80/443.
DEMO_HTTP_PORT=8088

# --- Proveedor del modelo -------------------------------------------------------
# API key de https://deepinfra.com/dash/api_keys (solo vive en el servidor).
DEEPINFRA_API_KEY=
# Id del modelo tal cual aparece en https://deepinfra.com/models
DEMO_MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct
# Nombre público del modelo (lo que ven el chat y los clientes de /v1).
DEMO_MODEL_NAME=sooniverse-demo
# Opcional: cualquier otro proveedor OpenAI-compatible (p.ej.
# https://api.together.xyz/v1). Vacío = DeepInfra nativo de LiteLLM.
DEMO_API_BASE=

# --- Identidad del despliegue -------------------------------------------------
CLIENTE_ID=demo
ENTORNO=prod
TIME_ZONE=America/Bogota

# --- LiteLLM --------------------------------------------------------------------
# Debe empezar por 'sk-'. Solo para administración; nunca se reparte.
LITELLM_MASTER_KEY=sk-CAMBIA-ESTO
LITELLM_SALT_KEY=CAMBIA-ESTO

# --- PostgreSQL propio del demo (contenedor 'postgres', sin puertos publicados) --
DB_NAME=sooniverse
DB_USER=sooniverse
DB_PASSWORD=CAMBIA-ESTO
DB_HOST=postgres
DB_PORT=5432

# --- Panel (Django) -------------------------------------------------------------
SECRET_KEY=CAMBIA-ESTO
DEBUG=False
ALLOWED_HOSTS=demo.tudominio.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://demo.tudominio.com
# true con HTTPS real (Nginx host + certbot). Para una prueba local por
# http://localhost:8088 ponlo en false.
HTTPS_ACTIVO=true
FORCE_SCRIPT_NAME=/panel
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@tudominio.com
DJANGO_SUPERUSER_PASSWORD=CAMBIA-ESTO
# Simula el pool de workers como sano (en el demo no hay GPUs propias).
VITRINA=true
# Segundos entre refrescos del ETL de consumo (producción: 300).
METRICS_REFRESH_INTERVAL=60
METRICS_COSTE_HORA_USD=0

# --- URLs públicas ----------------------------------------------------------------
GATEWAY_PUBLIC_URL=https://demo.tudominio.com
PUBLIC_BASE_URL=https://demo.tudominio.com
CHAT_URL=https://demo.tudominio.com/
SOONIVERSE_PANEL_URL=https://demo.tudominio.com/panel/

# --- Open WebUI -------------------------------------------------------------------
# Cuenta técnica del bootstrap de modelos (no es un usuario humano).
OPENWEBUI_BOOTSTRAP_EMAIL=bootstrap@sooniverse.internal
OPENWEBUI_BOOTSTRAP_PASSWORD=CAMBIA-ESTO
WEBUI_SIGNUP=false
