# ==============================================================================
# Sooniverse Infra - Plantilla de variables de entorno
# ==============================================================================
# Copiar a `.env` y completar. El archivo `.env` está en .gitignore y es la
# fuente autoritativa de credenciales para:
#   · scripts/db_setup.py        (ingesta del esquema PostgreSQL)
#   · docker_images/gateway/*    (docker compose --env-file ../../.env)
#   · django_metrics/            (panel de métricas fuera de Docker)
# SkyPilot lo monta en el Nodo Gateway; nunca llega a los workers.
# ==============================================================================

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga
DEBUG=False
ALLOWED_HOSTS=*
# Origen(es) HTTPS confiables para CSRF cuando hay dominio propio.
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Bogota
# Prefijo bajo el que nginx expone el panel (ver docker_images/gateway/nginx/
# default.conf, location /panel/). Vacío solo si accedes a metrics:8000 directo
# (gateway.exponer_puertos_directos: true), nunca detrás de nginx.
FORCE_SCRIPT_NAME=/panel

# ── PostgreSQL (compartida por LiteLLM y el panel de métricas) ────────────────
# Debe ser alcanzable DESDE el Nodo Gateway. Si usas el perfil `local-db` del
# docker compose, fija DB_HOST=postgres.
DB_NAME=sooniverse
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── LiteLLM Proxy ─────────────────────────────────────────────────────────────
# Master key: autoriza la emisión de API Keys y el acceso del panel al proxy.
LITELLM_MASTER_KEY=sk-sooniverse-master-CHANGE-ME
# Sal de cifrado. Fijarla UNA vez: si cambia, las keys emitidas quedan ilegibles.
LITELLM_SALT_KEY=sooniverse-salt-CHANGE-ME

# ── Panel de métricas (Django) ────────────────────────────────────────────────
# Superusuario creado/actualizado de forma idempotente en cada arranque.
# Contraseña vacía => no se crea usuario.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@sooniverse.co
# Segundos entre refrescos automáticos del ETL de métricas. 0 desactiva el job.
METRICS_REFRESH_INTERVAL=300

# ── Open WebUI ────────────────────────────────────────────────────────────────
# true permite auto-registro público; mantener en false en producción.
WEBUI_SIGNUP=false
# URL pública real del Gateway (IP o dominio), inyectada por el generador tras
# el primer 'sky launch'. Usada por Open WebUI para construir enlaces absolutos.
GATEWAY_PUBLIC_URL=

# ── AWS (aprovisionamiento vía SkyPilot) ──────────────────────────────────────
# Preferible configurar con `aws configure` en lugar de exponerlas aquí.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
